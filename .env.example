# ---------------------------------------------------------------------------
# NovaRetail Supply Chain Assistant - environment configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- LLM provider: Google AI / Gemini (required) ----------------------------
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY is also accepted if that is what you already have exported.
GOOGLE_API_KEY=

# Alternative: Vertex AI backend, no API key needed. Log in with
# `gcloud auth application-default login`, then set:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Model used by every agent.
#   gemini-3.1-flash-lite  cost-efficient, high throughput  (default)
#   gemini-3.6-flash       step up for harder agentic reasoning
#   gemini-3.5-flash-lite  fastest / cheapest of the 3.5 line
SUPPLYCHAIN_MODEL=gemini-3.1-flash-lite

# Reasoning depth for the worker agents (Gemini `thinking_level`):
# minimal | low | medium | high
SUPPLYCHAIN_REASONING_EFFORT=medium

# Reasoning depth for intake extraction and supervisor routing. These are short
# classification steps on the critical path of every turn, so they run lower.
SUPPLYCHAIN_ROUTER_REASONING_EFFORT=low

# Max output tokens per LLM call.
SUPPLYCHAIN_MAX_OUTPUT_TOKENS=4096

# --- LangSmith tracing (required by the capstone brief) ---------------------
# Get a key at https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=novaretail-supplychain
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Data layer -------------------------------------------------------------
# Leave blank to read the bundled JSON fixtures in
# src/supplychain/data/mock/. Set it to the base URL of the mock REST API
# supplied with the project to switch every tool over to HTTP, e.g.
# SUPPLYCHAIN_API_BASE_URL=http://localhost:8000
SUPPLYCHAIN_API_BASE_URL=

# --- Workflow behaviour -----------------------------------------------------
# Hard cap on supervisor routing hops per user request (loop guard).
SUPPLYCHAIN_MAX_HOPS=8

# Require human approval before write actions (create_incident,
# reroute_shipment, escalate_incident). Set to false for unattended demos.
SUPPLYCHAIN_REQUIRE_APPROVAL=true
